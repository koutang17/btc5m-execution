# Copy to .env (never commit) or set as user environment variables.

# --- dashboard ---
DASH_USER=admin
DASH_PASS=change-me-to-a-12-plus-character-secret
DASH_VIEW_PASS=change-me-readonly

# --- paths ---
BTC5M_HOME=C:\path\to\btc5m
BAW_JS=C:\path\to\node_modules\@binance\agentic-wallet\dist\index.js
NODE_EXE=C:\Program Files\nodejs\node.exe

# --- account ---
ACCOUNT_ID=A
BASE_STAKE=1

# --- notifications ---
NOTIFY_PROVIDER=wecom
NOTIFY_WEBHOOK_URL=
